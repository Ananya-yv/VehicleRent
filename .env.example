# =============================================================================
# Supabase Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# Your Supabase project URL (from Settings > API)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key - safe to expose in browser (from Settings > API)
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Service role key - SERVER-ONLY, never expose to frontend! (from Settings > API)
# This key bypasses RLS and has full database access
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key
